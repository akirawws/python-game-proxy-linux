# Нормализация переводов строк: в репозитории храним LF.
* text=auto eol=lf

# Shell-скрипты и Python-код должны иметь LF, иначе ломаются shebang и запуск на Linux.
*.sh       text eol=lf
*.py       text eol=lf
*.html     text eol=lf
*.css      text eol=lf
*.js       text eol=lf
*.json     text eol=lf
*.md       text eol=lf
*.toml     text eol=lf
*.txt      text eol=lf
*.service  text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf

# Windows-скрипты, если появятся, должны сохранять CRLF.
*.ps1      text eol=crlf
*.bat      text eol=crlf
*.cmd      text eol=crlf

# Бинарные файлы не нормализуем.
*.docx     binary
*.xlsx     binary
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.pdf      binary
*.zip      binary
